# ===============================================================
# CaféFlow PS62 — Full-Stack Deployment Environment Template
# ===============================================================

# ---------------------------------------------------------------
# BACKEND (RENDER WEB SERVICE)
# ---------------------------------------------------------------
# Node Environment
NODE_ENV=production

# Server Port (Render sets this automatically)
PORT=5000

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas -> Connect -> Drivers -> Node.js
# Ensure Database User has readWrite role and Network Access has 0.0.0.0/0
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxx.mongodb.net/cafeflow?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars

# Frontend URLs allowed by CORS
# Set to your Vercel deployment URL
CLIENT_URL=https://your-cafeflow-app.vercel.app,http://localhost:5173

# ---------------------------------------------------------------
# FRONTEND (VERCEL PROJECT)
# ---------------------------------------------------------------
# Render Backend API Endpoint
# In Vercel Project Settings -> Environment Variables:
VITE_API_URL=https://your-cafeflow-backend.onrender.com/api
