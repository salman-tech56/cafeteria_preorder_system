# ========================================================
# CaféFlow Backend Environment Variables (.env.example)
# ========================================================

# Port (Render automatically injects PORT in production)
PORT=5000

# Environment mode: 'development' | 'production'
NODE_ENV=production

# Database Connection URI
# Local: mongodb://127.0.0.1:27017/cafeflow
# Production (MongoDB Atlas):
# mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/cafeflow?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/cafeflow?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random key in production)
JWT_SECRET=generate_a_secure_random_jwt_secret_for_production_here

# Frontend Client Origin for CORS
# Comma-separated if multiple domains (e.g. Vercel deployment URL and localhost)
# Example: https://cafeflow.vercel.app,http://localhost:5173
CLIENT_URL=https://cafeflow.vercel.app,http://localhost:5173
