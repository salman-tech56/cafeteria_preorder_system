# ========================================================
# CaféFlow Backend Environment Variables (.env.example)
# ========================================================

# Server Port
PORT=5000

# Environment mode: 'development' | 'production'
NODE_ENV=production

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cafeflow
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# JWT Authentication Secret (Use a strong random key in production)
JWT_SECRET=generate_a_secure_random_jwt_secret_for_production_here

# Frontend Client Origin for CORS
CLIENT_URL=https://your-cafeflow-app.vercel.app,http://localhost:5173
